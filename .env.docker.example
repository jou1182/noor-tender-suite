# Database configuration
POSTGRES_USER=contech_user
POSTGRES_PASSWORD=contech_pass
POSTGRES_DB=contech_db
DATABASE_URL=postgresql://contech_user:contech_pass@postgres:5432/contech_db

# Qdrant configuration
QDRANT_URL=http://qdrant:6333

# Redis configuration
REDIS_URL=redis://redis:6379/0

# API Keys
OPENAI_API_KEY=your-openai-api-key-here

# General
ENVIRONMENT=production
