# Database configuration
POSTGRES_USER=noor_user
POSTGRES_PASSWORD=noor_pass
POSTGRES_DB=noor_db
DATABASE_URL=postgresql://noor_user:noor_pass@postgres:5432/noor_db

# Qdrant configuration
QDRANT_URL=http://qdrant:6333

# Redis configuration
REDIS_URL=redis://redis:6379/0

# API Keys
OPENAI_API_KEY=your-openai-api-key-here

# General
ENVIRONMENT=production
